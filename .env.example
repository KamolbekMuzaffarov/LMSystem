# ──────────────────────────────────────────────────────────────
# Aurora Academy — muhit o'zgaruvchilari (namuna)
# Bu faylni `.env.local` deb nusxalang va qiymatlarni to'ldiring.
# `.env.local` hech qachon git'ga qo'shilmaydi (.gitignore'da).
# ──────────────────────────────────────────────────────────────

# Supabase loyihangiz sozlamalaridan oling:
#   Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ⚠️ FAQAT server tomonida ishlatiladi — RLS'ni chetlab o'tadi.
# Hech qachon brauzerga/klientga oshkor qilmang va NEXT_PUBLIC_ prefiksini QO'YMANG.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
